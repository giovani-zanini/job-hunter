meta {
  name: Create a new profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/profiles/
  body: json
  auth: inherit
}

body:json {
  {
    "slug": "",
    "full_name": "",
    "title": "",
    "bio": ""
  }
}

example {
  name: 201 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/profiles/
    method: POST
    mode: json
    body:json: {
      {
        "slug": "",
        "full_name": "",
        "title": "",
        "bio": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "user_id": 0,
          "slug": "",
          "full_name": "",
          "title": "",
          "bio": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/profiles/
    method: POST
    mode: json
    body:json: {
      {
        "slug": "",
        "full_name": "",
        "title": "",
        "bio": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
