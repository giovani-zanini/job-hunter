meta {
  name: Add a link to a profile
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/profiles/:profile_id/links/:link_id
  body: none
  auth: inherit
}

params:path {
  profile_id: 
  link_id: 
}

