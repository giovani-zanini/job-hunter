meta {
  name: Create a new link
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/links/
  body: json
  auth: inherit
}

body:json {
  {
    "type": "",
    "from": "",
    "value": ""
  }
}

example {
  name: 201 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/links/
    method: POST
    mode: json
    body:json: {
      {
        "type": "",
        "from": "",
        "value": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "user_id": 0,
          "type": "",
          "from": "",
          "value": ""
        }
      '''
    }
  }
}

example {
