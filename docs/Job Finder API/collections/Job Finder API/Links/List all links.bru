meta {
  name: List all links
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/links/
  body: none
  auth: inherit
}

params:query {
  ~user_id: 
  ~type: 
  ~from: 
  ~include_deleted: 
  ~skip: 
  ~limit: 
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/links/
    method: GET
    mode: none
