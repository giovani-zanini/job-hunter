meta {
  name: Create a new education record
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/education/
  body: json
  auth: inherit
}

body:json {
  {
    "user_id": 0,
    "institution_name": "",
    "degree": "",
    "field_of_study": "",
    "start_date": "",
    "end_date": "",
    "skill_ids": []
  }
}

example {
  name: 201 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/education/
    method: POST
    mode: json
    body:json: {
      {
        "user_id": 0,
        "institution_name": "",
        "degree": "",
        "field_of_study": "",
        "start_date": "",
        "end_date": "",
        "skill_ids": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "user_id": 0,
          "institution_name": "",
          "degree": "",
          "field_of_study": "",
          "start_date": "",
          "end_date": "",
          "deleted_at": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/education/
    method: POST
    mode: json
    body:json: {
      {
        "user_id": 0,
        "institution_name": "",
        "degree": "",
        "field_of_study": "",
        "start_date": "",
        "end_date": "",
        "skill_ids": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
