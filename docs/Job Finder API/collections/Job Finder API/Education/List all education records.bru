meta {
  name: List all education records
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/education/
  body: none
  auth: inherit
}

params:query {
  ~user_id: 
  ~institution_name: 
  ~degree: 
  ~field_of_study: 
  ~include_deleted: 
  ~skip: 
  ~limit: 
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/education/
    method: GET
    mode: none
    params:query: {
      ~user_id: 
      ~institution_name: 
      ~degree: 
      ~field_of_study: 
      ~include_deleted: 
      ~skip: 
      ~limit: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 0,
            "user_id": 0,
            "institution_name": "",
            "degree": "",
            "field_of_study": "",
            "start_date": "",
            "end_date": ""
          }
        ]
      '''
    }
  }
}

