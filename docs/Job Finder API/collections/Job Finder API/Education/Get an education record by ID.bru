meta {
  name: Get an education record by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/education/:education_id
  body: none
  auth: inherit
}

params:query {
  ~include_deleted: 
}

params:path {
  education_id: 
}

