meta {
  name: List all certificates
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/certificates/
  body: none
  auth: inherit
}

params:query {
  ~user_id: 
  ~name: 
  ~issuer: 
  ~include_deleted: 
  ~skip: 
  ~limit: 
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/certificates/
    method: GET
    mode: none
    params:query: {
      ~user_id: 
      ~name: 
      ~issuer: 
      ~include_deleted: 
      ~skip: 
      ~limit: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": 0,
            "user_id": 0,
            "name": "",
            "issuer": "",
            "issue_date": "",
            "expiration_date": "",
            "credential_url": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/certificates/
    method: GET
    mode: none
    params:query: {
      ~user_id: 
      ~name: 
      ~issuer: 
      ~include_deleted: 
      ~skip: 
      ~limit: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
