meta {
  name: Update a certificate
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/certificates/:certificate_id
  body: json
  auth: inherit
}

params:path {
  certificate_id: 
}

body:json {
  {
    "name": "",
    "issuer": "",
    "issue_date": "",
    "expiration_date": "",
    "credential_url": ""
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/certificates/:certificate_id
