meta {
  name: Create a new certificate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/certificates/
  body: json
  auth: inherit
}

body:json {
  {
    "user_id": 0,
    "name": "",
    "issuer": "",
    "issue_date": "",
    "expiration_date": "",
    "credential_url": "",
    "skill_ids": []
  }
}

example {
  name: 201 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/certificates/
    method: POST
    mode: json
    body:json: {
      {
        "user_id": 0,
        "name": "",
        "issuer": "",
        "issue_date": "",
        "expiration_date": "",
        "credential_url": "",
        "skill_ids": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "user_id": 0,
          "name": "",
          "issuer": "",
          "issue_date": "",
          "expiration_date": "",
          "credential_url": "",
          "deleted_at": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/certificates/
    method: POST
    mode: json
    body:json: {
      {
        "user_id": 0,
        "name": "",
        "issuer": "",
        "issue_date": "",
        "expiration_date": "",
        "credential_url": "",
        "skill_ids": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
