meta {
  name: Update an education record
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/education/:education_id
  body: json
  auth: inherit
}

params:path {
  education_id: 
}

body:json {
  {
    "institution_name": "",
    "degree": "",
    "field_of_study": "",
    "start_date": "",
    "end_date": ""
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/education/:education_id
    method: PUT
    mode: json
    params:path: {
      education_id: 
    }
  
    body:json: {
      {
        "institution_name": "",
        "degree": "",
        "field_of_study": "",
        "start_date": "",
        "end_date": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
