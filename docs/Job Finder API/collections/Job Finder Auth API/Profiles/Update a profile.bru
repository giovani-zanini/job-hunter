meta {
  name: Update a profile
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/profiles/:profile_id
  body: json
  auth: inherit
}

params:path {
  profile_id: 
}

body:json {
  {
    "slug": "",
    "full_name": "",
    "title": "",
    "bio": ""
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/profiles/:profile_id
    method: PUT
    mode: json
    params:path: {
      profile_id: 
    }
  
    body:json: {
      {
        "slug": "",
        "full_name": "",
        "title": "",
        "bio": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "user_id": 0,
          "slug": "",
          "full_name": "",
          "title": "",
          "bio": ""
        }
      '''
    }
  }
}

