meta {
  name: Reset password using recovery token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "recovery_token": "",
    "new_password": ""
  }
}

example {
  name: 204 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "recovery_token": "",
        "new_password": ""
      }
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "recovery_token": "",
        "new_password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
