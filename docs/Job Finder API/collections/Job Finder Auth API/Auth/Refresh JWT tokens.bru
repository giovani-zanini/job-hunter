meta {
  name: Refresh JWT tokens
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh-token
  body: json
  auth: inherit
}

body:json {
  {
    "refresh_token": ""
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/auth/refresh-token
    method: POST
    mode: json
    body:json: {
      {
        "refresh_token": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "access_token": "",
          "refresh_token": "",
          "token_type": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/auth/refresh-token
    method: POST
    mode: json
    body:json: {
      {
        "refresh_token": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": ""
            }
          ]
        }
      '''
    }
  }
}
