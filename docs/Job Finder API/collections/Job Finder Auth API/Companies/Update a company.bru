meta {
  name: Update a company
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/companies/:company_id
  body: json
  auth: inherit
}

params:path {
  company_id: 
}

body:json {
  {
    "name": "",
    "website": ""
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/v1/companies/:company_id
    method: PUT
    mode: json
    params:path: {
      company_id: 
    }
  
    body:json: {
      {
        "name": "",
        "website": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "website": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/v1/companies/:company_id
    method: PUT
    mode: json
    params:path: {
      company_id: 
    }
  
    body:json: {
      {
        "name": "",
        "website": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
