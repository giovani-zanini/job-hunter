meta {
  name: Update an experience
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/experiences/:experience_id
  body: json
  auth: inherit
}

params:path {
  experience_id: 
}

body:json {
  {
    "company_id": "",
    "position_title": "",
    "start_date": "",
    "end_date": "",
    "description": ""
  }
}

