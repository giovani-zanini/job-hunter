{
  "$defs": {
    "CertificateCreateRequest": {
      "description": "Schema for creating a new certificate.",
      "properties": {
        "credential_url": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Credential URL",
          "title": "Credential Url"
        },
        "expiration_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expiration date (optional)",
          "title": "Expiration Date"
        },
        "issue_date": {
          "description": "Issue date",
          "format": "date",
          "title": "Issue Date",
          "type": "string"
        },
        "issuer": {
          "description": "Issuing organization",
          "maxLength": 100,
          "title": "Issuer",
          "type": "string"
        },
        "name": {
          "description": "Certificate name",
          "maxLength": 100,
          "title": "Name",
          "type": "string"
        },
        "skill_ids": {
          "default": [],
          "description": "Skill IDs to associate",
          "items": {
            "type": "integer"
          },
          "title": "Skill Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "issuer",
        "issue_date"
      ],
      "title": "CertificateCreateRequest",
      "type": "object"
    },
    "CertificateDetailResponse": {
