        "id",
        "user_id",
        "name",
        "issuer",
        "issue_date"
      ],
      "title": "CertificateDetailResponse",
      "type": "object"
    },
    "CertificateFilterParams": {
      "description": "Schema for certificate list filters.",
      "properties": {
        "include_deleted": {
          "default": false,
          "description": "Include soft deleted certificates",
          "title": "Include Deleted",
          "type": "boolean"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by issuer (partial match)",
          "title": "Issuer"
        },
        "limit": {
          "default": 20,
          "description": "Maximum number of records to return",
