          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "AchievementInput",
      "type": "object"
    },
    "AchievementResponse": {
      "description": "Schema for achievement response.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "experience_id": {
          "title": "Experience Id",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "experience_id",
        "title",
        "description"
