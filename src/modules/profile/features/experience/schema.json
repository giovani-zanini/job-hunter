          "description": "Achievement description",
          "title": "Description"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Achievement title",
          "title": "Title"
