            "$ref": "#/$defs/AchievementInput"
          },
          "title": "Achievements",
          "type": "array"
        },
        "company_id": {
          "description": "Company ID",
          "title": "Company Id",
          "type": "integer"
        },
        "description": {
          "description": "Job description",
          "title": "Description",
          "type": "string"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
